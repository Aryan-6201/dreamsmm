"use client";

import { useEffect, useMemo, useState } from "react";

type User = {
  id: string;
  name: string | null;
  email: string;
  username?: string | null;
};

type Popup = {
  id: number;
  title: string;
  message: string;
  imageUrl: string | null;
  buttonText: string | null;
  buttonUrl: string | null;
  targetType: "ALL" | "SPECIFIC";
  type: "ANNOUNCEMENT" | "SUCCESS" | "OFFER" | "WARNING" | "MAINTENANCE";
  theme: "CYAN" | "VIOLET" | "GREEN" | "ORANGE" | "RED" | "DARK";
  priority: number;
  autoClose: number | null;
  active: boolean;
  showOnce: boolean;
  expiresAt: string | null;
  createdAt: string;
  recipientCount: number;
};

export default function AdminPopupsPage() {
  const [popups, setPopups] = useState<Popup[]>([]);
  const [users, setUsers] = useState<User[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [duplicating, setDuplicating] = useState<number | null>(null);
  const [deleting, setDeleting] = useState<number | null>(null);
  const [editingId, setEditingId] = useState<number | null>(null);
  const [popupType, setPopupType] = useState<"ANNOUNCEMENT" | "SUCCESS" | "OFFER" | "WARNING" | "MAINTENANCE">("ANNOUNCEMENT");
  const [popupTheme, setPopupTheme] = useState<"CYAN" | "VIOLET" | "GREEN" | "ORANGE" | "RED" | "DARK">("CYAN");
  const [priority, setPriority] = useState(0);
  const [autoClose, setAutoClose] = useState<number | null>(null);

  const [title, setTitle] = useState("");
  const [popupMessage, setPopupMessage] = useState("");
  const [imageUrl, setImageUrl] = useState("");
  const [buttonText, setButtonText] = useState("");
  const [buttonUrl, setButtonUrl] = useState("");
  const [targetType, setTargetType] = useState<"ALL" | "SPECIFIC">("ALL");
  const [selectedUsers, setSelectedUsers] = useState<string[]>([]);
  const [userSearch, setUserSearch] = useState("");
  const [active, setActive] = useState(true);
  const [showOnce, setShowOnce] = useState(true);
  const [expiresAt, setExpiresAt] = useState("");

  const [preview, setPreview] = useState(false);
  const [notice, setNotice] = useState<{
    type: "success" | "error";
    text: string;
  } | null>(null);

  async function loadData() {
    try {
      setLoading(true);

      const [popupResponse, usersResponse] = await Promise.all([
        fetch("/api/admin/popups", { cache: "no-store" }),
        fetch("/api/admin/users", { cache: "no-store" }),
      ]);

      const popupData = await popupResponse.json();
      const usersData = await usersResponse.json();

      if (!popupResponse.ok) {
        throw new Error(popupData.error || "Could not load popups.");
      }

      if (!usersResponse.ok) {
        throw new Error(usersData.error || "Could not load users.");
      }

      setPopups(popupData.popups || []);
      setUsers(usersData.users || []);
    } catch (error) {
      setNotice({
        type: "error",
        text:
          error instanceof Error
            ? error.message
            : "Could not load popup data.",
      });
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadData();
  }, []);

  const filteredUsers = useMemo(() => {
    const query = userSearch.trim().toLowerCase();

    if (!query) return users;

    return users.filter((user) =>
      [
        user.email,
        user.name || "",
        user.username || "",
      ]
        .join(" ")
        .toLowerCase()
        .includes(query)
    );
  }, [users, userSearch]);

  const stats = useMemo(() => {
    const now = new Date();

    const activeCount = popups.filter(
      (popup) => popup.active && (!popup.expiresAt || new Date(popup.expiresAt) > now)
    ).length;

    const expiredCount = popups.filter(
      (popup) => popup.expiresAt && new Date(popup.expiresAt) <= now
    ).length;

    return {
      total: popups.length,
      active: activeCount,
      expired: expiredCount,
      inactive: popups.length - activeCount - expiredCount,
    };
  }, [popups]);

  function toggleUser(userId: string) {
    setSelectedUsers((current) =>
      current.includes(userId)
        ? current.filter((id) => id !== userId)
        : [...current, userId]
    );
  }

  function selectVisibleUsers() {
    setSelectedUsers((current) => [
      ...new Set([...current, ...filteredUsers.map((user) => user.id)]),
    ]);
  }

  function clearVisibleUsers() {
    const ids = new Set(filteredUsers.map((user) => user.id));

    setSelectedUsers((current) =>
      current.filter((id) => !ids.has(id))
    );
  }

  function startEdit(popup: Popup) {
    setEditingId(popup.id);
    setTitle(popup.title);
    setPopupMessage(popup.message);
    setImageUrl(popup.imageUrl || "");
    setButtonText(popup.buttonText || "");
    setButtonUrl(popup.buttonUrl || "");
    setTargetType(popup.targetType);
    setPopupType(popup.type || "ANNOUNCEMENT");
    setPopupTheme(popup.theme || "CYAN");
    setPriority(popup.priority ?? 0);
    setAutoClose(popup.autoClose ?? null);
    setActive(popup.active);
    setShowOnce(popup.showOnce);
    setExpiresAt(
      popup.expiresAt
        ? new Date(popup.expiresAt).toISOString().slice(0, 16)
        : ""
    );
    setNotice(null);
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function resetForm() {
    setEditingId(null);
    setTitle("");
    setPopupMessage("");
    setImageUrl("");
    setButtonText("");
    setButtonUrl("");
    setTargetType("ALL");
    setSelectedUsers([]);
    setUserSearch("");
    setActive(true);
    setShowOnce(true);
    setExpiresAt("");
  }

  async function updatePopup() {
    if (!editingId) return;

    setNotice(null);

    if (!title.trim()) {
      setNotice({ type: "error", text: "Popup title is required." });
      return;
    }

    if (!popupMessage.trim()) {
      setNotice({ type: "error", text: "Popup message is required." });
      return;
    }

    try {
      setSaving(true);

      const response = await fetch("/api/admin/popups", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          id: editingId,
          title: title.trim(),
          message: popupMessage.trim(),
          imageUrl: imageUrl.trim() || null,
          buttonText: buttonText.trim() || null,
          buttonUrl: buttonUrl.trim() || null,
          targetType,
          active,
          showOnce,
          type: popupType,
          theme: popupTheme,
          priority,
          autoClose,
          expiresAt: expiresAt
            ? new Date(expiresAt).toISOString()
            : null,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Could not update popup.");
      }

      setNotice({
        type: "success",
        text: "Popup updated successfully.",
      });

      resetForm();
      await loadData();
    } catch (error) {
      setNotice({
        type: "error",
        text:
          error instanceof Error
            ? error.message
            : "Could not update popup.",
      });
    } finally {
      setSaving(false);
    }
  }
  async function createPopup() {
    setNotice(null);

    if (!title.trim()) {
      setNotice({ type: "error", text: "Popup title is required." });
      return;
    }

    if (!popupMessage.trim()) {
      setNotice({ type: "error", text: "Popup message is required." });
      return;
    }

    if (targetType === "SPECIFIC" && selectedUsers.length === 0) {
      setNotice({ type: "error", text: "Select at least one user." });
      return;
    }

    try {
      setSaving(true);

      const response = await fetch("/api/admin/popups", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          title: title.trim(),
          message: popupMessage.trim(),
          imageUrl: imageUrl.trim() || null,
          buttonText: buttonText.trim() || null,
          buttonUrl: buttonUrl.trim() || null,
          targetType,
          type: popupType,
          theme: popupTheme,
          priority,
          autoClose,
          active,
          showOnce,
          expiresAt: expiresAt
            ? new Date(expiresAt).toISOString()
            : null,
          userIds: targetType === "SPECIFIC" ? selectedUsers : [],
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Could not create popup.");
      }

      setNotice({
        type: "success",
        text: "Popup created successfully.",
      });

      resetForm();
      await loadData();
    } catch (error) {
      setNotice({
        type: "error",
        text:
          error instanceof Error
            ? error.message
            : "Could not create popup.",
      });
    } finally {
      setSaving(false);
    }
  }

  async function deletePopup(popup: Popup) {
    const confirmed = window.confirm(
      `Delete "${popup.title}" permanently? This cannot be undone.`
    );

    if (!confirmed) return;

    try {
      setDeleting(popup.id);
      setNotice(null);

      const response = await fetch("/api/admin/popups", {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          id: popup.id,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Could not delete popup.");
      }

      if (editingId === popup.id) {
        resetForm();
      }

      setNotice({
        type: "success",
        text: "Popup deleted successfully.",
      });

      await loadData();
    } catch (error) {
      setNotice({
        type: "error",
        text:
          error instanceof Error
            ? error.message
            : "Could not delete popup.",
      });
    } finally {
      setDeleting(null);
    }
  }
  async function duplicatePopup(popup: Popup) {
    try {
      setDuplicating(popup.id);
      setNotice(null);

      const response = await fetch("/api/admin/popups", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          title: `${popup.title} (Copy)`,
          message: popup.message,
          imageUrl: popup.imageUrl,
          buttonText: popup.buttonText,
          buttonUrl: popup.buttonUrl,
          targetType: popup.targetType,
          active: false,
          showOnce: popup.showOnce,
          expiresAt: popup.expiresAt,
          userIds: [],
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || "Could not duplicate popup.");
      }

      setNotice({
        type: "success",
        text: "Popup duplicated as an inactive copy.",
      });

      await loadData();
    } catch (error) {
      setNotice({
        type: "error",
        text:
          error instanceof Error
            ? error.message
            : "Could not duplicate popup.",
      });
    } finally {
      setDuplicating(null);
    }
  }

  function getStatus(popup: Popup) {
    if (popup.expiresAt && new Date(popup.expiresAt) <= new Date()) {
      return "EXPIRED";
    }

    if (!popup.active) {
      return "INACTIVE";
    }

    return "LIVE";
  }

  function statusClasses(status: string) {
    if (status === "LIVE") {
      return "bg-emerald-50 text-emerald-700 border-emerald-100";
    }

    if (status === "EXPIRED") {
      return "bg-red-50 text-red-700 border-red-100";
    }

    return "bg-slate-100 text-slate-500 border-slate-200";
  }

  return (
    <main className="min-h-screen bg-[#f5f8fb] text-slate-900">
      <div className="border-b border-slate-200 bg-white">
        <div className="mx-auto max-w-[1500px] px-5 py-7 lg:px-8">
          <div className="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div>
              <div className="mb-2 flex items-center gap-2">
                <span className="h-2 w-2 rounded-full bg-cyan-500 shadow-[0_0_12px_rgba(6,182,212,.7)]" />
                <span className="text-[10px] font-extrabold uppercase tracking-[0.2em] text-cyan-600">
                  DreamSMM Control Center
                </span>
              </div>

              <h1 className="text-3xl font-black tracking-tight text-slate-950">
                Popup Manager
              </h1>

              <p className="mt-1 text-sm text-slate-500">
                Manage targeted announcements and user campaigns.
              </p>
            </div>

            <a
              href="/admin/popups/analytics"
              className="inline-flex items-center gap-2 rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-2.5 text-sm font-bold text-cyan-700 transition hover:bg-cyan-100"
            >
              <span>📊</span>
              Analytics
            </a>

            <button
              type="button"
              onClick={loadData}
              className="rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-sm transition hover:border-cyan-300 hover:text-cyan-700"
            >
              ↻ Refresh
            </button>
          </div>
        </div>
      </div>

      <div className="mx-auto max-w-[1500px] px-5 py-7 lg:px-8">
        {notice && (
          <div
            className={`mb-6 rounded-2xl border px-5 py-4 text-sm font-semibold ${
              notice.type === "success"
                ? "border-emerald-200 bg-emerald-50 text-emerald-700"
                : "border-red-200 bg-red-50 text-red-700"
            }`}
          >
            {notice.text}
          </div>
        )}

        {/* STATS */}
        <div className="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {[
            ["Total Popups", stats.total, "All announcements"],
            ["Live", stats.active, "Currently active"],
            ["Expired", stats.expired, "Past expiry"],
            ["Inactive", stats.inactive, "Not displaying"],
          ].map(([label, value, description]) => (
            <div
              key={String(label)}
              className="rounded-3xl border border-slate-200 bg-white p-5 shadow-[0_10px_35px_rgba(15,23,42,.05)]"
            >
              <p className="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">
                {label}
              </p>
              <p className="mt-2 text-3xl font-black tracking-tight text-slate-950">
                {value}
              </p>
              <p className="mt-1 text-xs text-slate-400">
                {description}
              </p>
            </div>
          ))}
        </div>

        <div className="grid gap-6 xl:grid-cols-[minmax(0,1fr)_400px]">
          {/* CREATE */}
          <section className="rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_15px_50px_rgba(15,23,42,.06)]">
            <div className="mb-7 flex items-start justify-between">
              <div>
                <h2 className="text-xl font-black text-slate-950">
                  {editingId ? "Edit Popup" : "Create Popup"}
                </h2>
                <p className="mt-1 text-sm text-slate-500">
                  Build a personalized announcement for your users.
                </p>
              </div>

              <span className="rounded-full bg-cyan-50 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-cyan-700">
                Campaign
              </span>
            </div>

            <div className="space-y-6">
              <div>
                <label className="mb-2 block text-sm font-bold text-slate-700">
                  Title
                </label>
                <input
                  value={title}
                  onChange={(e) => setTitle(e.target.value)}
                  placeholder="New service is now available!"
                  className="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm outline-none transition focus:border-cyan-400 focus:bg-white focus:ring-4 focus:ring-cyan-500/10"
                />
              </div>

              <div>
                <div className="mb-2 flex justify-between">
                  <label className="text-sm font-bold text-slate-700">
                    Message
                  </label>
                  <span className="text-xs text-slate-400">
                    {popupMessage.length}/1000
                  </span>
                </div>

                <textarea
                  value={popupMessage}
                  maxLength={1000}
                  onChange={(e) => setPopupMessage(e.target.value)}
                  rows={6}
                  placeholder="Write your announcement..."
                  className="w-full resize-none rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm leading-6 outline-none transition focus:border-cyan-400 focus:bg-white focus:ring-4 focus:ring-cyan-500/10"
                />
              </div>

              <div>
                <label className="mb-2 block text-sm font-bold text-slate-700">
                  Image URL
                  <span className="ml-2 text-xs font-normal text-slate-400">
                    Optional
                  </span>
                </label>

                <input
                  value={imageUrl}
                  onChange={(e) => setImageUrl(e.target.value)}
                  placeholder="https://example.com/banner.jpg"
                  className="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm outline-none focus:border-cyan-400 focus:bg-white"
                />

                {imageUrl && (
                  <div className="mt-3 overflow-hidden rounded-2xl border border-slate-200">
                    <img
                      src={imageUrl}
                      alt=""
                      className="h-36 w-full object-cover"
                      onError={(e) => {
                        e.currentTarget.style.display = "none";
                      }}
                    />
                  </div>
                )}
              </div>

              <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p className="mb-4 text-[10px] font-black uppercase tracking-[0.16em] text-slate-400">
                  Call to action
                </p>

                <div className="grid gap-4 md:grid-cols-2">
                  <input
                    value={buttonText}
                    onChange={(e) => setButtonText(e.target.value)}
                    placeholder="Button text"
                    className="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:border-cyan-400"
                  />

                  <input
                    value={buttonUrl}
                    onChange={(e) => setButtonUrl(e.target.value)}
                    placeholder="/dashboard or https://..."
                    className="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:border-cyan-400"
                  />
                </div>
              </div>

              <div>
                <label className="mb-3 block text-sm font-bold text-slate-700">
                  Audience
                </label>

                <div className="grid grid-cols-2 gap-3">
                  <button
                    type="button"
                    onClick={() => {
                      setTargetType("ALL");
                      setSelectedUsers([]);
                    }}
                    className={`rounded-2xl border p-4 text-left transition ${
                      targetType === "ALL"
                        ? "border-cyan-400 bg-cyan-50 ring-2 ring-cyan-500/10"
                        : "border-slate-200 bg-white hover:border-slate-300"
                    }`}
                  >
                    <p className="font-bold">All Users</p>
                    <p className="mt-1 text-xs text-slate-500">
                      Everyone on the panel
                    </p>
                  </button>

                  <button
                    type="button"
                    onClick={() => setTargetType("SPECIFIC")}
                    className={`rounded-2xl border p-4 text-left transition ${
                      targetType === "SPECIFIC"
                        ? "border-cyan-400 bg-cyan-50 ring-2 ring-cyan-500/10"
                        : "border-slate-200 bg-white hover:border-slate-300"
                    }`}
                  >
                    <p className="font-bold">Specific Users</p>
                    <p className="mt-1 text-xs text-slate-500">
                      Personal targeting
                    </p>
                  </button>
                </div>
              </div>

              {targetType === "SPECIFIC" && (
                <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                  <div className="mb-3 flex items-center justify-between">
                    <div>
                      <p className="font-bold">Select Users</p>
                      <p className="text-xs text-slate-500">
                        {selectedUsers.length} selected
                      </p>
                    </div>

                    <div className="flex gap-2">
                      <button
                        type="button"
                        onClick={selectVisibleUsers}
                        className="rounded-lg bg-white px-3 py-2 text-xs font-bold text-cyan-700 shadow-sm"
                      >
                        Select
                      </button>

                      <button
                        type="button"
                        onClick={clearVisibleUsers}
                        className="rounded-lg bg-white px-3 py-2 text-xs font-bold text-slate-500 shadow-sm"
                      >
                        Clear
                      </button>
                    </div>
                  </div>

                  <input
                    value={userSearch}
                    onChange={(e) => setUserSearch(e.target.value)}
                    placeholder="Search users..."
                    className="mb-3 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none focus:border-cyan-400"
                  />

                  <div className="max-h-56 space-y-2 overflow-y-auto">
                    {filteredUsers.map((user) => {
                      const selected = selectedUsers.includes(user.id);

                      return (
                        <button
                          type="button"
                          key={user.id}
                          onClick={() => toggleUser(user.id)}
                          className={`flex w-full items-center gap-3 rounded-xl border p-3 text-left ${
                            selected
                              ? "border-cyan-300 bg-cyan-50"
                              : "border-transparent bg-white hover:border-slate-200"
                          }`}
                        >
                          <span
                            className={`flex h-5 w-5 items-center justify-center rounded-md border text-xs font-bold ${
                              selected
                                ? "border-cyan-500 bg-cyan-500 text-white"
                                : "border-slate-300"
                            }`}
                          >
                            {selected ? "✓" : ""}
                          </span>

                          <span className="min-w-0">
                            <span className="block truncate text-sm font-bold">
                              {user.name ||
                                user.username ||
                                "Unnamed User"}
                            </span>
                            <span className="block truncate text-xs text-slate-500">
                              {user.email}
                            </span>
                          </span>
                        </button>
                      );
                    })}
                  </div>
                </div>
              )}

              <div className="grid gap-4 md:grid-cols-3">
                <label className="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                  <input
                    type="checkbox"
                    checked={active}
                    onChange={(e) => setActive(e.target.checked)}
                    className="h-4 w-4 accent-cyan-500"
                  />
                  <span>
                    <span className="block text-sm font-bold">Active</span>
                    <span className="text-xs text-slate-400">
                      Show now
                    </span>
                  </span>
                </label>

                <label className="flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                  <input
                    type="checkbox"
                    checked={showOnce}
                    onChange={(e) => setShowOnce(e.target.checked)}
                    className="h-4 w-4 accent-cyan-500"
                  />
                  <span>
                    <span className="block text-sm font-bold">
                      Show once
                    </span>
                    <span className="text-xs text-slate-400">
                      Remember close
                    </span>
                  </span>
                </label>

                <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                  <div className="mb-4 grid gap-4 md:grid-cols-3">
                    <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                      <label className="mb-2 block text-sm font-bold">Popup Type</label>
                      <select value={popupType} onChange={(e) => setPopupType(e.target.value as "ANNOUNCEMENT" | "SUCCESS" | "OFFER" | "WARNING" | "MAINTENANCE")} className="relative z-10 w-full cursor-pointer bg-transparent text-sm outline-none pointer-events-auto">
                        <option value="ANNOUNCEMENT">Announcement</option>
                        <option value="SUCCESS">Success</option>
                        <option value="OFFER">Offer</option>
                        <option value="WARNING">Warning</option>
                        <option value="MAINTENANCE">Maintenance</option>
                      </select>
                    </div>
                    <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <div className="grid gap-4 md:grid-cols-3">
                      <div className="rounded-2xl border border-slate-200 bg-white p-4">
                        <label className="mb-2 block text-sm font-bold">Popup Type</label>
